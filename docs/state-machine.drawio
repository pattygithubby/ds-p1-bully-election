<mxfile host="65bd71144e">
    <diagram id="dmz4o3cre1zNeNLD5zgd" name="Bully (original)">
        <mxGraphModel dx="1140" dy="908" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="760" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;fontSize=16;align=left;" value="&lt;b&gt;Bully algorithm: the states of one node&lt;/b&gt;" vertex="1">
                    <mxGeometry height="30" width="600" x="40" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="start" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
                    <mxGeometry height="30" width="30" x="40" y="285" as="geometry"/>
                </mxCell>
                <mxCell id="down" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Down&lt;/b&gt;&lt;br&gt;crashed or just restarted" vertex="1">
                    <mxGeometry height="80" width="180" x="110" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="election" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Election&lt;/b&gt;&lt;br&gt;paused, waiting for a winner" vertex="1">
                    <mxGeometry height="80" width="180" x="480" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="reorg" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Reorganization&lt;/b&gt;&lt;br&gt;knows the coordinator,&lt;br&gt;waiting for its task" vertex="1">
                    <mxGeometry height="80" width="180" x="850" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="normal" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Normal&lt;/b&gt;&lt;br&gt;working on the task" vertex="1">
                    <mxGeometry height="80" width="180" x="1220" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="t0" edge="1" parent="1" source="start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeWidth=1.5;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#ffffff;" target="down" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t1" edge="1" parent="1" source="down" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeWidth=1.5;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="election" value="restarts, or&lt;br&gt;gets Halt">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t2" edge="1" parent="1" source="election" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeWidth=1.5;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="reorg" value="gets NewCoordinator&lt;br&gt;(or won itself)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t3" edge="1" parent="1" source="reorg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeWidth=1.5;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="normal" value="gets Ready&lt;br&gt;(with its task)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t4" edge="1" parent="1" source="reorg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeWidth=1.5;strokeColor=#c26a00;fontColor=#c26a00;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" target="election" value="gets Halt, or something times out">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="940" y="210"/>
                            <mxPoint x="615" y="210"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t5" edge="1" parent="1" source="normal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeWidth=1.5;strokeColor=#c26a00;fontColor=#c26a00;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="election" value="coordinator is gone, or gets Halt">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1310" y="160"/>
                            <mxPoint x="570" y="160"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c1" edge="1" parent="1" source="election" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeWidth=1.5;strokeColor=#b85450;fontColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" target="down" value="">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="570" y="400"/>
                            <mxPoint x="245" y="400"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c2" edge="1" parent="1" source="reorg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeWidth=1.5;strokeColor=#b85450;fontColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="down" value="">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="940" y="430"/>
                            <mxPoint x="200" y="430"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c3" edge="1" parent="1" source="normal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeWidth=1.5;strokeColor=#b85450;fontColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" target="down" value="crash (can happen in any state)">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1310" y="460"/>
                            <mxPoint x="155" y="460"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="steps" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;How one election goes&lt;/b&gt; (higher ID = higher priority)&lt;br&gt;&lt;br&gt;1. Node i notices the coordinator is gone (or i has just restarted).&lt;br&gt;2. i asks every node with a &lt;b&gt;higher&lt;/b&gt; ID: &amp;quot;are you there?&amp;quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Someone answers: i gives up and waits. The higher node takes over.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Nobody answers: i has won.&lt;br&gt;3. The winner sends &lt;b&gt;Halt&lt;/b&gt; to every lower node. They stop and go to &lt;b&gt;Election&lt;/b&gt;.&lt;br&gt;4. The winner sends &lt;b&gt;NewCoordinator&lt;/b&gt;. They go to &lt;b&gt;Reorganization&lt;/b&gt;.&lt;br&gt;5. The winner sends &lt;b&gt;Ready&lt;/b&gt; with the task. Everyone goes to &lt;b&gt;Normal&lt;/b&gt;." vertex="1">
                    <mxGeometry height="190" width="560" x="110" y="520" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
